      <column caption='топ_3 категории' datatype='boolean' name='[Calculation_0456575203942400]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= 3'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='статус доставки' datatype='string' name='[Calculation_0456575221542913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN &apos;Опоздали&apos;&#13;&#10;ELSEIF ISNULL([order_delivered_customer_date]) THEN &apos;В пути / Отменен&apos;&#13;&#10;ELSE &apos;Вовремя&apos;&#13;&#10;END' />
      </column>
      <column caption='фильтр payment' datatype='real' name='[Calculation_0456575226847234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_value] &lt;= 1500 THEN [payment_value] END' />
      </column>
      <column caption='Полное название штата' datatype='string' name='[Calculation_0456575476146180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [customer_state]&#13;&#10;WHEN &apos;AC&apos; THEN &apos;Акри (Acre)&apos;&#13;&#10;WHEN &apos;AL&apos; THEN &apos;Алагоас (Alagoas)&apos;&#13;&#10;WHEN &apos;AM&apos; THEN &apos;Амазонас (Amazonas)&apos;&#13;&#10;WHEN &apos;AP&apos; THEN &apos;Амапа (Amapá)&apos;&#13;&#10;WHEN &apos;BA&apos; THEN &apos;Баия (Bahia)&apos;&#13;&#10;WHEN &apos;CE&apos; THEN &apos;Сеара (Ceará)&apos;&#13;&#10;WHEN &apos;DF&apos; THEN &apos;Федеральный округ (Distrito Federal)&apos;&#13;&#10;WHEN &apos;ES&apos; THEN &apos;Эспириту-Санту (Espírito Santo)&apos;&#13;&#10;WHEN &apos;GO&apos; THEN &apos;Гояс (Goiás)&apos;&#13;&#10;WHEN &apos;MA&apos; THEN &apos;Мараньян (Maranhão)&apos;&#13;&#10;WHEN &apos;MG&apos; THEN &apos;Минас-Жерайс (Minas Gerais)&apos;&#13;&#10;WHEN &apos;MS&apos; THEN &apos;Мату-Гросу-ду-Сул (Mato Grosso do Sul)&apos;&#13;&#10;WHEN &apos;MT&apos; THEN &apos;Мату-Гросу (Mato Grosso)&apos;&#13;&#10;WHEN &apos;PA&apos; THEN &apos;Пара (Pará)&apos;&#13;&#10;WHEN &apos;PB&apos; THEN &apos;Параиба (Paraíba)&apos;&#13;&#10;WHEN &apos;PE&apos; THEN &apos;Пернамбуку (Pernambuco)&apos;&#13;&#10;WHEN &apos;PI&apos; THEN &apos;Пиауи (Piauí)&apos;&#13;&#10;WHEN &apos;PR&apos; THEN &apos;Парана (Paraná)&apos;&#13;&#10;WHEN &apos;RJ&apos; THEN &apos;Рио-де-Жанейро (Rio de Janeiro)&apos;&#13;&#10;WHEN &apos;RN&apos; THEN &apos;Риу-Гранди-ду-Норти (Rio Grande do Norte)&apos;&#13;&#10;WHEN &apos;RO&apos; THEN &apos;Рондония (Rondônia)&apos;&#13;&#10;WHEN &apos;RR&apos; THEN &apos;Рорайма (Roraima)&apos;&#13;&#10;WHEN &apos;RS&apos; THEN &apos;Риу-Гранди-ду-Сул (Rio Grande do Sul)&apos;&#13;&#10;WHEN &apos;SC&apos; THEN &apos;Санта-Катарина (Santa Catarina)&apos;&#13;&#10;WHEN &apos;SE&apos; THEN &apos;Сержипи (Sergipe)&apos;&#13;&#10;WHEN &apos;SP&apos; THEN &apos;Сан-Паулу (São Paulo)&apos;&#13;&#10;WHEN &apos;TO&apos; THEN &apos;Токантинс (Tocantins)&apos;&#13;&#10;ELSE [customer_state]&#13;&#10;END' />
      </column>
